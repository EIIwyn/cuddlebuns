cuddlebuns.moe {
    # Root directory for the website
    root * /var/www/cuddlebuns/public

    # ========================================
    # COMPRESSION
    # ========================================
    # Compress responses for faster loading
    encode gzip zstd

    # ========================================
    # ASSET PROTECTION
    # ========================================

    # Block common scraper bots and download tools
    @bad_bots {
        path /assets/*
        header_regexp User-Agent (?i)(curl|wget|python-requests|scrapy|go-http-client|bot|crawler|spider)
    }
    respond @bad_bots "Access denied - Automated scraping is not permitted" 403

    # Optional: Uncomment to enable hotlink protection
    # (May interfere with social media sharing - test first!)
    # @hotlink {
    #     path /assets/*
    #     not header Referer *cuddlebuns.moe*
    #     not header Referer ""
    # }
    # respond @hotlink "Hotlinking not permitted. Please visit cuddlebuns.moe" 403

    # ========================================
    # FILE SERVER & SPA ROUTING
    # ========================================
    # Serve static files, fallback to index.html for React Router routes
    file_server {
        # Hide sensitive files and directories
        hide .git .env .htaccess
        # Disable directory browsing (prevents listing /assets/commissions/)
        # Note: Individual files still accessible, just can't browse folders
    }

    # SPA fallback - if file not found, serve index.html for client-side routing
    handle_errors {
        @notfound {
            expression {http.error.status_code} == 404
        }
        rewrite @notfound /index.html
        file_server
    }

    # ========================================
    # CACHING HEADERS
    # ========================================

    # Cache images and assets aggressively (1 year)
    @static_assets {
        path *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.woff *.woff2 *.ttf *.eot
        path /assets/*
    }
    header @static_assets {
        Cache-Control "public, max-age=31536000, immutable"
        # Add source attribution header
        X-Image-Source "cuddlebuns.moe"
    }

    # Cache CSS/JS for 30 days (shorter than images since they update more)
    @scripts {
        path *.css *.js
    }
    header @scripts Cache-Control "public, max-age=2592000"

    # Never cache HTML (ensures users get updates immediately)
    @html {
        path *.html
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    # Cache JSON data for 1 hour
    @json {
        path *.json
    }
    header @json Cache-Control "public, max-age=3600"

    # ========================================
    # SECURITY HEADERS
    # ========================================
    header {
        # Prevent clickjacking attacks
        X-Frame-Options "SAMEORIGIN"

        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"

        # Enable XSS protection (legacy browsers)
        X-XSS-Protection "1; mode=block"

        # Control referrer information
        Referrer-Policy "strict-origin-when-cross-origin"

        # Add security policy hint
        X-Content-Type-Options "nosniff"

        # CORS - Allow cross-origin requests (needed for API/assets)
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # ========================================
    # CORS PREFLIGHT
    # ========================================
    @options {
        method OPTIONS
    }
    respond @options 204

    # ========================================
    # CUSTOM ERROR PAGES (Optional)
    # ========================================
    # Uncomment to add custom error pages
    # handle_errors {
    #     @404 {
    #         expression {http.error.status_code} == 404
    #     }
    #     rewrite @404 /404.html
    #     file_server
    # }

    # ========================================
    # LOGGING (Optional but recommended)
    # ========================================
    # Uncomment to enable access logs
    # log {
    #     output file /var/log/caddy/cuddlebuns.log
    #     format json
    # }
}

# ========================================
# OPTIONAL: WWW REDIRECT
# ========================================
# Uncomment to redirect www to non-www
# www.cuddlebuns.moe {
#     redir https://cuddlebuns.moe{uri} permanent
# }
