cms.cuddlebuns.moe {
    encode gzip zstd

    # A Version may carry six 24 MiB reference sheets (144 MiB total).
    # Leave multipart framing and a small operational margin before Caddy
    # rejects an otherwise schema-valid upload with 413.
    request_body {
        max_size 160MB
    }

    reverse_proxy 127.0.0.1:8090 {
        # Replace, rather than forward, client-provided values. PocketBase
        # trusts X-Real-IP only from this localhost Caddy hop.
        header_up X-Real-IP {remote_host}

        transport http {
            read_timeout 6m
        }
    }
}

cuddlebuns.moe {
    # ========================================
    # COMPRESSION
    # ========================================
    encode gzip zstd

    # ========================================
    # SHARED / LEGACY FILES
    # ========================================
    # If the exact requested path exists in /var/www/cuddlebuns/public,
    # serve it from there first.
    #
    # Examples:
    #   /scarymovie6.mp4
    #   /miku/example.png
    #   /nano_movies/movie.mp4
    #
    # React routes such as /gallery and /uma will NOT match here unless
    # an actual file exists at that path inside /public.
    @public_file file {
        root /var/www/cuddlebuns/public
        try_files {path}
    }

    handle @public_file {
        root * /var/www/cuddlebuns/public

        file_server {
            hide .git .env .htaccess
        }
    }

    # ========================================
    # CURRENT SITE / SPA ROUTING
    # ========================================
    # Anything that wasn't an existing legacy/public file comes from the
    # current atomic release.
    handle {
        root * /var/www/cuddlebuns/current
        try_files {path} /index.html

        file_server {
            hide .git .env .htaccess
        }
    }

    # ========================================
    # CACHING HEADERS
    # ========================================

    @static_assets {
        path *.jpg *.jpeg *.png *.gif *.webp *.avif *.svg *.ico *.woff *.woff2 *.ttf *.eot
        path /assets/*
        path /generated/nocodb/*
    }

    header @static_assets {
        Cache-Control "public, max-age=31536000, immutable"
        X-Image-Source "cuddlebuns.moe"
    }

    @scripts {
        path *.css *.js
    }

    header @scripts Cache-Control "public, max-age=2592000"

    @html {
        path *.html
    }

    header @html Cache-Control "no-cache, no-store, must-revalidate"

    # CMS and timeline data should revalidate after each atomic release.
    @cms_json {
        path /data/cms/*.json /data/cms/*/*.json /data/uma/*.json
    }

    header @cms_json Cache-Control "no-cache, must-revalidate"

    # Other JSON files, including legacy/public JSON.
    @json {
        path *.json
        not path /data/cms/* /data/uma/*
    }

    header @json Cache-Control "public, max-age=3600"

    # ========================================
    # SECURITY HEADERS
    # ========================================
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"

        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # ========================================
    # CORS PREFLIGHT
    # ========================================
    @options {
        method OPTIONS
    }

    respond @options 204
    
}
