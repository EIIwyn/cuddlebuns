dev/*
repo/*
repos/
backups/*

# Site (React/Vite project)
site/node_modules/
site/dist/
site/.env
site/.env.local
site/.cache/
site/public/data/cms/
site/public/generated/nocodb/
*.log

# Assets (large image files - deploy separately via rsync)
# Images are managed outside git for performance
assets/
public/assets/

# Keep .gitkeep files to preserve folder structure
!assets/.gitkeep
!public/assets/.gitkeep

# Built site files are committed for deployment to public/
# public/*.html, public/*.js, public/*.css, public/static/ are tracked
site/public/data/uma/*.json
