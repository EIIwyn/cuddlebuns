#!/bin/bash
# Git post-receive hook for cuddlebuns.moe
# Place this file at: /var/www/cuddlebuns/repos/cuddlebuns.git/hooks/post-receive
# Make it executable: chmod +x post-receive

set -e

# Configuration
WORK_TREE="/var/www/cuddlebuns"
GIT_DIR="/var/www/cuddlebuns/repos/cuddlebuns.git"

echo "🚀 Deploying to cuddlebuns.moe..."

# Configure sparse checkout to only deploy production files
cd "$GIT_DIR"
git config core.sparseCheckout true

# Create sparse-checkout file with patterns for files we want on VPS
cat > "$GIT_DIR/info/sparse-checkout" << 'SPARSE_EOF'
# Only checkout production-ready files
public/
cuddlebuns.caddy
vps-scripts/

# Exclude development files
!site/
SPARSE_EOF

# Checkout the latest code to the work tree
git --work-tree="$WORK_TREE" --git-dir="$GIT_DIR" checkout -f main

# Restore assets if they were deleted by git checkout
# (Assets are managed separately and should not be touched by git)
if [ ! -d "$WORK_TREE/public/assets/commissions" ]; then
    echo "⚠ Assets were deleted by checkout - they should be synced separately via rsync"
fi

echo "✓ Code deployed to $WORK_TREE"

# Set correct permissions ONLY for gallery (not assets or other folders)
chown -R masterpyon:www-cuddlebuns "$WORK_TREE/public/gallery" 2>/dev/null || true
chmod -R 755 "$WORK_TREE/public/gallery" 2>/dev/null || true

echo "✓ Permissions set"

# Reload Caddy (if needed)
if sudo systemctl is-active --quiet caddy 2>/dev/null; then
    echo "🔄 Reloading Caddy..."
    sudo systemctl reload caddy 2>/dev/null && echo "✓ Caddy reloaded" || echo "⚠ Caddy reload failed (check sudo permissions)"
fi

echo "✅ Deployment complete!"
echo "🌐 Live at: https://cuddlebuns.moe"
